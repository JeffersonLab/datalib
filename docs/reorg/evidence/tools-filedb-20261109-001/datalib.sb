(version 1)
(allow default)
(deny file-read* (regex ".*/(adat[^/]*|libadat[^/]*)(/|$)"))
(deny file-read* (regex ".*/(qdp[^/]*|qmp[^/]*|libqdp[^/]*|libqmp[^/]*)(/|$)"))
(deny file-read* (regex ".*/xpath_reader[^/]*(/|$)"))
(deny file-read* (regex ".*/libXPathReader[^/]*(/|$)"))
(deny file-read* (regex ".*/libxmlWriter[^/]*(/|$)"))
