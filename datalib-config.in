#!/bin/sh
case "$1" in
 --cxxflags) echo '-I@prefix@/include @CXXFLAGS@ @DATALIB_XML_CFLAGS@';;
 --ldflags) echo '-L@prefix@/lib @LDFLAGS@';;
 --libs) echo '-ldatalib_serial @DATALIB_DEP_LIBS@';;
 --filedb-cxxflags|--filedb-ldflags|--filedb-libs|--storage-cxxflags|--storage-ldflags|--storage-libs)
   if test -z '@FILEDB_LIBS@'; then
     echo 'Storage flags require configuring datalib with FILEDB support' >&2
     exit 1
   fi
   case "$1" in
     --filedb-cxxflags|--storage-cxxflags) echo '@FILEDB_EXPORT_CXXFLAGS@';;
     --filedb-ldflags|--storage-ldflags) echo '@FILEDB_EXPORT_LDFLAGS@';;
     --filedb-libs|--storage-libs) echo '@FILEDB_LIBS@';;
   esac;;
 --prefix) echo '@prefix@';;
 --backend) echo serial;;
 *) echo 'usage: datalib-config --cxxflags|--ldflags|--libs|--prefix|--backend|--storage-cxxflags|--storage-ldflags|--storage-libs' >&2; exit 1;;
esac
